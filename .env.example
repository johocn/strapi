REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=0

# Aliyun OSS (zhao-oss) - 可选，不配置则使用本地存储
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_ACCESS_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_CNAME=

# SSO (zhao-sso) - 必填，用于 SSO 应用初始化（bootstrap 会据此创建 course 应用）
SSO_DEFAULT_APP_SECRET=

# Playwright (zhao-wealth) - 可选，采集功能需要 Chrome 浏览器
# Linux 服务器安装：yum install -y google-chrome-stable 或 apt install chromium-browser
# 未配置时使用默认路径：Windows=C:\...\chrome.exe，Linux=/usr/bin/google-chrome
PLAYWRIGHT_CHROME_PATH=
