# 密钥生成说明（每个环境单独生成，切勿复用示例值）：
#   openssl rand -base64 32     # 生成单个 32 字节密钥
#   APP_KEYS 需要 4 个随机密钥，用英文逗号分隔
# 复制为 .env 后填入真实值；.env 不得提交到仓库
HOST=0.0.0.0
PORT=1337
APP_KEYS="<APP_KEY_1>,<APP_KEY_2>,<APP_KEY_3>,<APP_KEY_4>"
API_TOKEN_SALT=<API_TOKEN_SALT>
ADMIN_JWT_SECRET=<ADMIN_JWT_SECRET>
TRANSFER_TOKEN_SALT=<TRANSFER_TOKEN_SALT>
ENCRYPTION_KEY=<ENCRYPTION_KEY>

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<DATABASE_PASSWORD>
DATABASE_SSL=false

# Redis (zhao-channel 插件使用 Bull 队列)
# 代码使用分段环境变量连接 Redis，无需 URL 编码密码
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=default
REDIS_DB=0

# Aliyun OSS (zhao-oss) - 可选，不配置则使用本地存储
# REGION 必须带 oss- 前缀，如 oss-cn-hangzhou
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
# 自定义域名/CDN（可选）
ALIYUN_OSS_CNAME=
# ECS 同地域内网 Endpoint（可选），如 oss-cn-hangzhou-internal.aliyuncs.com
ALIYUN_OSS_INTERNAL_ENDPOINT=
# 私有桶签名 URL 有效期（秒），默认 3600
ALIYUN_OSS_SIGNED_URL_EXPIRES=3600

# SSO (zhao-sso) - 必填，用于 SSO 应用初始化（bootstrap 会据此创建 course 应用）
SSO_DEFAULT_APP_SECRET=

# Playwright (zhao-wealth) - 可选，采集功能需要 Chrome 浏览器
# Linux 服务器安装：yum install -y google-chrome-stable 或 apt install chromium-browser
# 未配置时使用默认路径：Windows=C:\...\chrome.exe，Linux=/usr/bin/google-chrome
PLAYWRIGHT_CHROME_PATH=

# MeiliSearch 统一知识库 (zhao-search) - 与 vendure meilisearch-plugin 共用同一实例
# MEILI_ADMIN_KEY 为 Meili master key；ZHAO_SEARCH_SHARED_SECRET 为 strapi 管理路由服务间鉴权密钥
# （vendure 侧 ZHAO_SEARCH_REINDEX_URL 需指向 POST /v1/zhao-search/reindex）
MEILI_HOST=http://127.0.0.1:7700
MEILI_ADMIN_KEY=
ZHAO_SEARCH_SHARED_SECRET=
