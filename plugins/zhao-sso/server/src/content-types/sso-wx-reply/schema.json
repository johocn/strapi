    },
    "text": { "type": "text" },
    "title": { "type": "string" },
    "desc": { "type": "string" },
    "pic_url": { "type": "string" },
    "link_url": { "type": "string" },
    "sort": { "type": "integer", "default": 0 },
    "enabled": { "type": "boolean", "default": true }
  }
}